---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Poorbita — Building rural futures', description = 'Poorbita works with rural and tribal communities across West Bengal to strengthen livelihoods, skills and cultural heritage.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><link rel="icon" href="/favicon.svg"><meta name="theme-color" content="#245447"><title>{title}</title></head><body><Header/><main><slot/></main><Footer/></body></html>
