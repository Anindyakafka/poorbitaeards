---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProgramGallery, programs } from '../../data/site';
export function getStaticPaths() { return programs.map(program => ({ params: { slug: program.slug }, props: { program } })); }
const { program } = Astro.props;
const gallery = getProgramGallery(program.slug, program.galleryCount);
const currentIndex = programs.findIndex(item => item.slug === program.slug);
const nextProgram = programs[(currentIndex + 1) % programs.length];
---
<BaseLayout title={`${program.name} — Poorbita`} description={program.text}>
  <section class="program-hero"><div class="container program-hero-grid"><div><a class="back" href="/our-work">← All programs</a><p class="eyebrow">{program.number} — {program.name}</p><h1>{program.title}</h1><p class="intro">{program.text}</p></div><ul>{program.focus.map(item => <li>{item}</li>)}</ul></div></section>
  {program.image && <section class="feature"><div class="container"><img src={program.image} alt={program.alt ?? ''} width="1280" height="960" /></div></section>}
  {gallery.length ? <section class="section archive"><div class="container"><div class="section-head"><div><p class="eyebrow">From the field</p><h2>Moments from<br>the program.</h2></div><p>Scenes of learning, participation, creative practice and community activity connected with {program.name}.</p></div><div class="photo-grid">{gallery.map((photo, index) => <figure><button type="button" data-src={photo.src} data-index={index} aria-label={`Open a ${program.name} field photograph`}><img src={photo.src} alt={`${program.name} activity in the field`} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" /></button></figure>)}</div></div></section> : <section class="section empty-archive"><div class="container"><p class="eyebrow">A future program</p><h2>The vision comes first.</h2><p>There is no verified photo archive for {program.name} yet. Images will be added when this future initiative moves into documented activity.</p></div></section>}
  <section class="next"><div class="container"><p class="eyebrow">Continue exploring</p><a href={`/programs/${nextProgram.slug}`}><span>{nextProgram.name}</span><strong>{nextProgram.title}</strong><i>→</i></a></div></section>
  {gallery.length > 0 && <dialog class="lightbox"><div class="lightbox-bar"><span></span><button class="close" type="button" aria-label="Close photograph">×</button></div><button class="previous" type="button" aria-label="Previous photograph">←</button><img src="" alt="" /><button class="next-photo" type="button" aria-label="Next photograph">→</button></dialog>}
</BaseLayout>
<script>
  const dialog=document.querySelector<HTMLDialogElement>('.lightbox');const image=dialog?.querySelector<HTMLImageElement>('img');const counter=dialog?.querySelector<HTMLSpanElement>('.lightbox-bar span');const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-src]'));let active=0;
  const show=(index:number)=>{if(!dialog||!image||!buttons.length)return;active=(index+buttons.length)%buttons.length;image.src=buttons[active].dataset.src??'';image.alt=buttons[active].querySelector('img')?.alt??'';if(counter)counter.textContent=`${active+1} / ${buttons.length}`};
  buttons.forEach((button,index)=>button.addEventListener('click',()=>{show(index);dialog?.showModal()}));dialog?.querySelector('.close')?.addEventListener('click',()=>dialog.close());dialog?.querySelector('.previous')?.addEventListener('click',()=>show(active-1));dialog?.querySelector('.next-photo')?.addEventListener('click',()=>show(active+1));dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});document.addEventListener('keydown',event=>{if(!dialog?.open)return;if(event.key==='ArrowLeft')show(active-1);if(event.key==='ArrowRight')show(active+1)});
</script>
<style>
.program-hero{padding:155px 0 90px;background:var(--cream)}.program-hero-grid{display:grid;grid-template-columns:1.5fr .7fr;gap:100px;align-items:end}.back{display:inline-block;margin-bottom:55px;border-bottom:1px solid currentColor;font-size:.78rem;font-weight:600}.program-hero h1{max-width:850px}.intro{max-width:760px;margin-top:28px;color:var(--muted);font-size:1.1rem}.program-hero ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.program-hero li{padding:10px 0;border-bottom:1px solid var(--line);font-size:.8rem}.feature{padding:0 0 30px;background:linear-gradient(var(--cream) 50%,var(--paper) 50%)}.feature img{height:min(70vh,720px);object-fit:cover}.archive{padding-top:90px;overflow:hidden}.photo-grid{columns:3;column-gap:10px}.photo-grid figure{display:inline-block;width:100%;margin:0 0 10px;break-inside:avoid}.photo-grid button{display:block;width:100%;padding:0;border:0;background:var(--cream);cursor:zoom-in;overflow:hidden}.photo-grid img{width:100%;height:auto;transition:transform .35s ease}.photo-grid button:hover img{transform:scale(1.02)}.empty-archive{text-align:center}.empty-archive h2{margin-bottom:20px}.empty-archive p:last-child{max-width:630px;margin:auto;color:var(--muted)}.next{position:relative;clear:both;padding:85px 0;background:var(--green);color:white}.next .eyebrow{color:var(--gold)}.next a{display:grid;grid-template-columns:.7fr 1.3fr auto;gap:35px;align-items:center;border-top:1px solid #ffffff55;padding-top:28px}.next a span{font-size:.8rem}.next a strong{font:500 clamp(2rem,4vw,4rem) var(--serif)}.next a i{font:400 3rem var(--serif);font-style:normal}.lightbox{width:100vw;height:100vh;max-width:none;max-height:none;margin:0;padding:20px;border:0;background:#102720f2;color:#fff}.lightbox::backdrop{background:#102720}.lightbox[open]{display:grid;grid-template-columns:70px 1fr 70px;grid-template-rows:auto 1fr;align-items:center}.lightbox-bar{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center}.lightbox-bar button{border:0;background:none;color:white;font-size:2.2rem;cursor:pointer}.lightbox>img{grid-column:2;max-width:100%;height:calc(100vh - 90px);object-fit:contain}.lightbox>.previous,.lightbox>.next-photo{border:0;background:none;color:white;font-size:2rem;cursor:pointer}.lightbox>.previous{grid-column:1;grid-row:2}.lightbox>.next-photo{grid-column:3;grid-row:2}
@media(max-width:900px){.photo-grid{columns:2}}
@media(max-width:700px){.program-hero-grid{grid-template-columns:1fr;gap:45px}.back{margin-bottom:40px}.feature .container{width:100%}.feature img{height:auto;max-height:70vh}.photo-grid{column-gap:5px}.photo-grid figure{margin-bottom:5px}.next a{grid-template-columns:1fr auto;gap:10px}.next a span{grid-column:1/-1}.lightbox{padding:10px}.lightbox[open]{grid-template-columns:42px 1fr 42px}.lightbox>img{height:calc(100vh - 75px)}}@media(prefers-reduced-motion:reduce){.photo-grid img{transition:none}}
</style>
