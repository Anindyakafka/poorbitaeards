---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programs } from '../data/site';
---
<BaseLayout title="Our Programs — Poorbita" description="Explore Poorbita programs for Indigenous people, children, adolescent girls and women, spanning education, health, culture, sustainable farming and livelihoods.">
  <section class="page-hero programs-hero"><div class="container"><p class="eyebrow">Our Programs</p><h1>Connected programs.<br>Community-led change.</h1><p>Eight program families connect education, livelihood, health, culture and rural life. Explore each one through the people, activities and places documented by Poorbita.</p></div></section>
  <section class="section program-index"><div class="container"><div class="section-head"><div><p class="eyebrow">Explore the programs</p><h2>Every pathway<br>has a purpose.</h2></div><p>Each gallery draws from Poorbita’s own field archive. Photographs are grouped by the program information supplied by the organisation.</p></div><div class="program-grid">{programs.map((program, index) => <article class:list={{ noImage: !program.image }}>
    {program.image ? <a class="program-image" href={`/programs/${program.slug}`} aria-label={`Explore ${program.name}`}><img src={program.image} alt={program.alt ?? ''} loading={index < 2 ? 'eager' : 'lazy'} /></a> : <div class="program-placeholder" aria-hidden="true"><span>Future</span><i>08</i></div>}
    <div class="program-card-copy"><div class="program-meta"><span>{program.number}</span><span>{program.galleryCount ? 'Stories from the field' : 'A future vision'}</span></div><p class="program-name">{program.name}</p><h2>{program.title}</h2><p>{program.text}</p><ul>{program.focus.slice(0, 3).map(item => <li>{item}</li>)}</ul><a class="text-link" href={`/programs/${program.slug}`}>{program.galleryCount ? 'Explore program & gallery' : 'Explore the vision'} <span>→</span></a></div>
  </article>)}</div></div></section>
  <section class="section impact"><div class="container"><div class="section-head"><div><p class="eyebrow">Documented reach</p><h2>What the client’s records tell us.</h2></div><p>Kishalay’s current reach is confirmed in the client-approved brochure. The remaining cumulative figures come from program records supplied by EARDS.</p></div><div class="impact-grid"><article><strong>200+</strong><p>children currently reached through Poorbita Kishalay</p></article><article><strong>650+</strong><p>Scheduled Tribe families reached through pisciculture across more than 66 self-help groups</p></article><article><strong>75+</strong><p>Indigenous families supported through animal husbandry and organic kitchen gardens</p></article><article><strong>3</strong><p>Poorbita Rural Development campuses across Birbhum and Purba Bardhaman</p></article></div></div></section>
  <section class="recognition"><div class="container"><p class="eyebrow">Recognition</p><h2>Commitment seen and celebrated.</h2><p>Poorbita Kishalay is a recipient of The Telegraph School Awards for Excellence. EARDS has also been honoured by the Rotary Club for contributions to education and community development, and its work has been featured by ABP Ananda, Bartaman, Eastern Chronicle and other regional media.</p></div></section>
</BaseLayout>
<style>
.programs-hero h1{max-width:1050px}.program-index{background:var(--paper)}.program-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:70px 28px}.program-grid article{min-width:0}.program-image{display:block;overflow:hidden;background:var(--cream);aspect-ratio:4/3}.program-image img{height:100%;object-fit:cover;transition:transform .5s ease}.program-image:hover img{transform:scale(1.025)}.program-card-copy{padding:28px 5px 0}.program-meta{display:flex;justify-content:space-between;padding-bottom:14px;border-bottom:1px solid var(--line);color:var(--rust);font-size:.68rem;text-transform:uppercase;letter-spacing:.12em}.program-name{margin:25px 0 8px;font-weight:600}.program-card-copy h2{font-size:clamp(2.15rem,3.6vw,3.65rem)}.program-card-copy>p:not(.program-name){max-width:590px;margin-top:18px;color:var(--muted)}.program-card-copy ul{display:flex;flex-wrap:wrap;gap:7px;list-style:none;margin:25px 0;padding:0}.program-card-copy li{padding:6px 10px;border:1px solid var(--line);font-size:.68rem}.text-link{display:inline-flex;align-items:center;gap:12px;border-bottom:1px solid currentColor;padding:8px 0;font-size:.8rem;font-weight:600}.program-placeholder{aspect-ratio:4/3;background:var(--green);color:white;display:flex;align-items:center;justify-content:center;gap:25px}.program-placeholder span{font:italic 3rem var(--serif)}.program-placeholder i{font:500 7rem var(--serif);color:var(--gold);font-style:normal}.impact{background:var(--green);color:#fff}.impact .eyebrow{color:var(--gold)}.impact .section-head>p{color:#c2d2cd}.impact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.impact-grid article{border-top:1px solid #ffffff55;padding-top:20px}.impact-grid strong{font:500 4rem var(--serif)}.impact-grid p{color:#d5e0dc;font-size:.82rem}.recognition{padding:110px 0;background:var(--rust);color:white}.recognition .eyebrow{color:#ffe5bb}.recognition h2{max-width:700px}.recognition p:last-child{max-width:780px;margin-top:28px;color:#f8ded6}
@media(max-width:760px){.program-grid,.impact-grid{grid-template-columns:1fr}.program-grid{gap:55px}.program-card-copy{padding-top:22px}.program-placeholder i{font-size:5rem}.recognition{padding:75px 0}}@media(prefers-reduced-motion:reduce){.program-image img{transition:none}}
</style>
