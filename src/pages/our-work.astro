---
import BaseLayout from '../layouts/BaseLayout.astro'; import { programs } from '../data/site';
const details=[['Skill development','Training has included embroidery and tailoring, cane and bamboo work, batik and tie-dye, alongside design development workshops for rural artisans.','/images/b2.jpg'],['Farming & fishery','Community livelihood programs support agriculture, horticulture, floriculture and pisciculture with training designed around local resources.','/images/support.jpg'],['Craft & culture','Poorbita has supported artisans and tribal folk performers, including participation in cultural programs and festivals across West Bengal.','/images/g4.jpg'],['Community support','The organisation’s documented mission extends to community wellbeing and rehabilitation support for senior citizens.','/images/b1.jpg']];
---
<BaseLayout title="Our Work — Poorbita"><section class="page-hero"><div class="container"><p class="eyebrow">Our work</p><h1>Skills become<br>possibility.</h1><p>We combine capacity building, livelihood support and cultural conservation to help rural communities build durable routes forward.</p></div></section><section class="section overview"><div class="container"><div class="programs">{programs.map(p=><article><span>{p.number}</span><h3>{p.title}</h3><p>{p.text}</p></article>)}</div></div></section><section class="details">{details.map((item,i)=><article class:list={{reverse:i%2}}><img src={item[2]} alt="Poorbita program activity" loading="lazy"><div><p class="eyebrow">Program area {String(i+1).padStart(2,'0')}</p><h2>{item[0]}</h2><p>{item[1]}</p><a href="/contact" class="text-link">Talk to us about this work →</a></div></article>)}</section><section class="section record"><div class="container"><p class="eyebrow">Documented programs</p><h2>Work carried out across West Bengal.</h2><ul><li>Embroidery and tailoring training with members of Dhaniakhali LAMPS, Hooghly.</li><li>Cane and bamboo training with members of Aushgram-I Block LAMPS, Bardhaman.</li><li>Community pisciculture schemes in Bolpur–Sriniketan and Garhbeta-II.</li><li>Tribal folk dance participation at Poush Mela, Jangalmahal Utsab and other cultural programs.</li></ul></div></section></BaseLayout>
<style>.overview{background:var(--cream)}.programs{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line)}.programs article{background:var(--cream);padding:50px}.programs span{color:var(--rust);font-size:.75rem}.programs h3{margin:25px 0 15px}.programs p{color:var(--muted)}.details article{display:grid;grid-template-columns:1fr 1fr;min-height:570px}.details article.reverse img{order:2}.details img{height:100%;min-height:570px;object-fit:cover}.details article>div{padding:80px clamp(30px,7vw,100px);display:flex;flex-direction:column;justify-content:center}.details article>div>p:not(.eyebrow){margin:25px 0;color:var(--muted)}.text-link{align-self:flex-start}.record{background:var(--green);color:white}.record h2{max-width:700px}.record ul{display:grid;grid-template-columns:1fr 1fr;gap:25px 60px;margin:50px 0 0;padding:0;list-style:none}.record li{border-top:1px solid #ffffff45;padding-top:18px}@media(max-width:760px){.programs,.details article,.record ul{grid-template-columns:1fr}.programs article{padding:30px}.details article.reverse img{order:0}.details img{min-height:390px}.details article>div{padding:60px 25px}}</style>
