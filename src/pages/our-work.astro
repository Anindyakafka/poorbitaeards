---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programs } from '../data/site';
---
<BaseLayout title="Our Programs — Poorbita" description="Explore Poorbita programs for Indigenous people, children, adolescent girls and women, spanning education, health, culture, sustainable farming and livelihoods.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Our Programs</p><h1>One community.<br>Many pathways forward.</h1><p>Eight connected programs respond to the priorities of Indigenous people, children, adolescents and women across education, livelihood, health, culture and rural life.</p></div></section>

  <section class="section intro"><div class="container intro-grid"><h2>Holistic by design.</h2><p>A child’s education is shaped by nutrition, family income, health, confidence and culture. Poorbita therefore works alongside Indigenous families across those connections instead of treating each challenge in isolation.</p></div></section>

  <section class="program-list">{programs.map((program, i) => <article id={program.name.toLowerCase().replaceAll(' ', '-')} class:list={{ dark: i % 3 === 1 }}><div class="container program"><div class="program-name"><span>{program.number}</span><p>{program.name}</p></div><div class="program-copy">{program.image && <img src={program.image} alt={program.alt ?? ''} loading="lazy" width="1280" height="960" />}<h2>{program.title}</h2><p>{program.text}</p></div><ul>{program.focus.map(item => <li>{item}</li>)}</ul></div></article>)}</section>

  <section class="section impact"><div class="container"><div class="section-head"><div><p class="eyebrow">Documented reach</p><h2>What the client’s records tell us.</h2></div><p>These figures come from current client-supplied material and should be tied to a reporting year in the next formal impact report.</p></div><div class="impact-grid"><article><strong>250+</strong><p>children supported through Poorbita Kishalay across four Indigenous community areas</p></article><article><strong>650+</strong><p>Scheduled Tribe families reached through pisciculture across more than 66 self-help groups</p></article><article><strong>75+</strong><p>Indigenous families supported through animal husbandry and organic kitchen gardens</p></article><article><strong>3</strong><p>Rural Development and Craft Centres across Birbhum and Purba Bardhaman</p></article></div></div></section>

  <section class="recognition"><div class="container"><p class="eyebrow">Recognition</p><h2>Commitment seen and celebrated.</h2><p>Poorbita Kishalay has received The Telegraph School Awards for Excellence through The Somak Dutta Endowment for its contribution to the education of children from underserved Indigenous communities. EARDS has also been acknowledged by Rotary for literacy, organic farming, agriculture and skill development initiatives.</p></div></section>
</BaseLayout>
<style>
.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:start}.intro-grid p{font:400 1.35rem/1.55 var(--serif);color:var(--muted)}.program-list article{padding:70px 0;border-top:1px solid var(--line)}.program-list article.dark{background:var(--cream)}.program{display:grid;grid-template-columns:.7fr 1.4fr .9fr;gap:60px;align-items:start}.program-name{display:flex;gap:22px;align-items:baseline}.program-name span{color:var(--rust);font-size:.72rem}.program-name p{font-weight:600}.program-copy img{width:100%;aspect-ratio:4/3;object-fit:cover;margin-bottom:32px}.program-copy>p{margin-top:20px;color:var(--muted);max-width:600px}.program ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.program li{padding:9px 0;border-bottom:1px solid var(--line);font-size:.82rem}.impact{background:var(--green);color:#fff}.impact .eyebrow{color:var(--gold)}.impact .section-head>p{color:#c2d2cd}.impact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.impact-grid article{border-top:1px solid #ffffff55;padding-top:20px}.impact-grid strong{font:500 4rem var(--serif)}.impact-grid p{color:#d5e0dc;font-size:.82rem}.recognition{padding:110px 0;background:var(--rust);color:white}.recognition .eyebrow{color:#ffe5bb}.recognition h2{max-width:700px}.recognition p:last-child{max-width:780px;margin-top:28px;color:#f8ded6}
@media(max-width:850px){.program{grid-template-columns:1fr 2fr}.program ul{grid-column:2}.impact-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.intro-grid,.program,.impact-grid{grid-template-columns:1fr}.intro-grid{gap:25px}.program-list article{padding:52px 0}.program ul{grid-column:auto}.recognition{padding:75px 0}}
</style>
