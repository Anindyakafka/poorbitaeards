---
import BaseLayout from '../layouts/BaseLayout.astro';
const values = [
  ['Accountability', 'We work with integrity, take responsibility for outcomes and communicate honestly about both progress and setbacks.'],
  ['Excellence', 'We remain curious, challenge assumptions and keep improving the quality and relevance of our work.'],
  ['Respect', 'We listen openly and treat every person, culture and point of view with dignity.'],
  ['Trust', 'We believe in one another’s potential and create space to share experience, responsibility and learning.'],
];
const compliance = [
  ['Society registration', 'SO134449 of 2005–2006'],
  ['NGO Darpan / NITI Aayog', 'WB/2017/0153657'],
  ['12A registration', 'AAAAE7910L23KL01'],
  ['80G registration', 'AAAAE7910L24KL01'],
  ['PAN', 'AAAAE7910L'],
  ['CSR-1 registration', 'CSR00036703'],
];
---
<BaseLayout title="About Poorbita" description="Learn about EARDS, the organisation behind Poorbita, its mission, values, centres and legal registrations.">
  <section class="page-hero"><div class="container"><p class="eyebrow">About Poorbita</p><h1>Rooted here.<br>Growing together.</h1><p>A people-centred movement for education, dignity and sustainable opportunity across rural West Bengal.</p></div></section>

  <section class="section"><div class="container story"><div><p class="eyebrow">Our story</p><h2>Development begins with dignity.</h2></div><div class="prose"><p>Egra Agriculture and Rural Development Society (EARDS) is a registered non-profit founded by professionals committed to people-centred development. Since 2006, the organisation has worked across West Bengal with Indigenous people and other rural communities, with particular attention to children, adolescents and women facing social and economic exclusion.</p><p>Its public initiatives are brought together under the name <strong>Poorbita</strong>. The programs link child education and nutrition with health, women’s empowerment, skill development, traditional craft, sustainable agriculture and community awareness—because lasting change rarely comes from addressing one need in isolation.</p></div></div></section>

  <section class="centres"><div class="centres-photo"><img src="/images/img_03.jpg" alt="Poorbita participants holding certificates after a skills program"></div><div class="centres-copy"><p class="eyebrow">Where we work</p><h2>Three campuses. One shared purpose.</h2><p>Poorbita Rural Development campuses serve Indigenous and rural communities at Sarpukurdanga and Sehalai in Santiniketan, and Jadabganj in Ausgram. Poorbita Kishalay currently reaches more than 200 children, particularly from Scheduled Tribe and Scheduled Caste communities.</p><p>Across these locations, local educators and practitioners help bridge linguistic, educational and economic barriers with culturally sensitive support.</p></div></section>

  <section class="section vision-mission"><div class="container vm-grid"><article><p class="eyebrow">Vision</p><h2>Every child deserves the chance to learn and dream.</h2><p>Irrespective of socio-economic background, every child should have the opportunity to learn, dream and realise their full potential.</p></article><article><p class="eyebrow">Mission</p><h2>Education that reaches beyond textbooks.</h2><p>Poorbita nurtures knowledge, character, creativity, confidence and physical well-being through education, craft, art, culture and sport—combining modern learning with traditional Indigenous values.</p></article></div></section>
  <section class="section acknowledgments" id="acknowledgments"><div class="container story"><div><p class="eyebrow">Acknowledgments</p><h2>Progress is always shared.</h2></div><div class="prose"><p>We gratefully acknowledge the Indigenous communities, children, women, families, educators, volunteers, mentors, artisans, farmers, health professionals, supporters and partner institutions who shape and sustain Poorbita’s programs.</p><p>Their knowledge, trust and participation make this work possible. As verified names and partnership details become available, this section can grow into a fuller public record of contribution.</p></div></div></section>

  <section class="section values"><div class="container"><div class="section-head"><div><p class="eyebrow">Our values</p><h2>How we hold ourselves accountable.</h2></div><p>These principles shape decisions, partnerships and our responsibility to the communities we serve.</p></div><div class="value-grid">{values.map((value, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{value[0]}</h3><p>{value[1]}</p></article>)}</div></div></section>

  <section class="section compliance"><div class="container"><div class="section-head"><div><p class="eyebrow">Legal compliance</p><h2>Registered and accountable.</h2></div><p>Identifiers supplied by EARDS. Copies of current certificates should be verified before publishing downloadable documents.</p></div><dl>{compliance.map(item => <div><dt>{item[0]}</dt><dd>{item[1]}</dd></div>)}</dl></div></section>
</BaseLayout>
<style>
.story{display:grid;grid-template-columns:1fr 1fr;gap:100px}.prose{font:400 1.25rem/1.65 var(--serif)}.prose p+p{margin-top:24px}.centres{display:grid;grid-template-columns:1.05fr .95fr;background:var(--green);color:#fff}.centres-photo img{height:650px;object-fit:cover}.centres-copy{padding:95px clamp(35px,8vw,115px);display:flex;flex-direction:column;justify-content:center}.centres-copy .eyebrow{color:var(--gold)}.centres-copy p:not(.eyebrow){margin-top:24px;color:#d2dfda}.vision-mission{background:var(--cream)}.vm-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line)}.vm-grid article{padding:55px;background:var(--cream)}.vm-grid h2{font-size:clamp(2rem,3.2vw,3.2rem)}.vm-grid p:last-child{margin-top:24px;color:var(--muted)}.value-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.value-grid article{padding:42px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.value-grid span{color:var(--rust);font-size:.75rem}.value-grid h3{margin:25px 0 14px}.value-grid p{color:var(--muted)}.compliance{background:var(--green-dark);color:#fff}.compliance .eyebrow{color:var(--gold)}.compliance .section-head>p{color:#bdd0ca}.compliance dl{display:grid;grid-template-columns:repeat(2,1fr);margin:0;border-top:1px solid #ffffff30}.compliance dl div{display:flex;justify-content:space-between;gap:25px;padding:20px;border-bottom:1px solid #ffffff30}.compliance dt{color:#bdd0ca}.compliance dd{margin:0;font-weight:600}
@media(max-width:760px){.story,.centres,.vm-grid,.value-grid,.compliance dl{grid-template-columns:1fr}.story{gap:30px}.centres-photo img{height:430px}.centres-copy{padding:65px 25px}.vm-grid article{padding:35px 24px}.compliance dl div{flex-direction:column;gap:5px}}
</style>
