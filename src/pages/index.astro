---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programs } from '../data/site';
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy container"><p class="eyebrow">Rooted in rural West Bengal</p><h1>When children learn,<br><em>communities flourish.</em></h1><p class="intro">Poorbita works alongside Indigenous people, children and women, connecting education and nutrition with skills, health, culture and sustainable livelihoods.</p><div class="actions"><a class="button" href="/our-work">Explore our programs <span class="arrow">↗</span></a><a class="text-link" href="/about">Our story <span>→</span></a></div></div>
    <div class="hero-photo"><img src="/images/bg2.jpg" alt="Members of a rural community supported by Poorbita" fetchpriority="high"><div class="photo-note"><span>Since</span><strong>2005</strong><span>West Bengal</span></div></div>
  </section>

  <section class="marquee" aria-label="Our focus"><div>Education <i>✦</i> Nutrition <i>✦</i> Skills <i>✦</i> Culture <i>✦</i> Community <i>✦</i></div></section>

  <section class="section intro-section"><div class="container split"><div><p class="eyebrow">Who we are</p><h2>Progress begins by listening.</h2></div><div><p class="lead">Poorbita is an initiative of Egra Agriculture and Rural Development Society. We work alongside Indigenous communities—especially children, adolescents and women—to strengthen learning, skills, resources and routes to a dignified income.</p><a class="text-link" href="/about">Get to know us <span>→</span></a></div></div></section>

  <section class="image-break"><img src="/images/img_03.jpg" alt="A Poorbita community gathering" loading="lazy"><blockquote>“Building the capacity to shape one’s own future.”</blockquote></section>

  <section class="section work"><div class="container"><div class="section-head"><div><p class="eyebrow">Our Programs</p><h2>Practical support.<br>Enduring change.</h2></div><p>Our programs connect education and nutrition with skills, health, culture and sustainable livelihoods.</p></div><div class="program-grid">{programs.slice(0, 4).map(program => <article><span>{program.number}</span><h3>{program.title}</h3><p>{program.text}</p><a href="/our-work" aria-label={`Learn about ${program.title}`}>Learn more →</a></article>)}</div></div></section>

  <section class="heritage"><div class="heritage-photo"><img src="/images/g4.jpg" alt="Traditional cultural performance supported by Poorbita" loading="lazy"></div><div class="heritage-copy"><p class="eyebrow">Culture carries us</p><h2>Heritage is a living livelihood.</h2><p>We help rural artisans and performers sustain the craft, dance and cultural traditions that hold generations together.</p><a class="button button--ghost" href="/gallery">See the gallery <span>↗</span></a></div></section>

  <section class="section history"><div class="container"><p class="eyebrow">A record of action</p><div class="history-grid"><h2>Years of work,<br>grounded locally.</h2><div class="milestone"><strong>200+</strong><p>children currently reached through Poorbita Kishalay.</p></div><div class="milestone"><strong>650+</strong><p>Scheduled Tribe families reached through community pisciculture programs.</p></div><div class="milestone"><strong>20+</strong><p>years since Egra Agriculture and Rural Development Society was registered.</p></div></div><p class="source-note">Kishalay’s current reach is confirmed in the client-approved brochure. Other cumulative figures come from program material supplied by EARDS.</p></div></section>
</BaseLayout>
<style>
.hero{min-height:780px;background:var(--cream);display:grid;grid-template-columns:58% 42%;position:relative;overflow:hidden}.hero-copy{width:min(760px,calc(100% - 40px));margin-left:max(20px,calc((100vw - 1180px)/2));padding:190px 45px 90px 0;z-index:2}.hero h1 em{color:var(--rust);font-weight:400}.intro{max-width:570px;margin-top:28px;font-size:1.12rem;color:var(--muted)}.actions{display:flex;align-items:center;gap:30px;margin-top:36px}.text-link{display:inline-flex;align-items:center;gap:12px;font-size:.85rem;font-weight:600;border-bottom:1px solid var(--ink);padding:8px 0}.hero-photo{position:relative;min-height:780px}.hero-photo img{height:100%;object-fit:cover}.hero-photo:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#f7f1e51f,transparent 30%)}.photo-note{position:absolute;z-index:2;bottom:30px;left:-66px;width:132px;height:132px;border-radius:50%;background:var(--gold);display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.1}.photo-note strong{font:500 2.2rem var(--serif)}.photo-note span{font-size:.62rem;text-transform:uppercase;letter-spacing:.1em}.marquee{overflow:hidden;padding:18px;background:var(--green);color:#fff;font:400 clamp(1.2rem,2.3vw,2rem) var(--serif);white-space:nowrap;text-align:center;word-spacing:25px}.marquee i{color:var(--gold);font-style:normal}.split{display:grid;grid-template-columns:1fr 1fr;gap:100px}.lead{font:400 clamp(1.25rem,2.1vw,1.7rem)/1.45 var(--serif);margin-bottom:30px}.image-break{height:610px;position:relative;margin:0 3vw;overflow:hidden}.image-break img{height:100%;object-fit:cover}.image-break:after{content:'';position:absolute;inset:0;background:#17352d4a}.image-break blockquote{position:absolute;z-index:2;bottom:50px;left:50px;color:#fff;max-width:650px;margin:0;font:500 clamp(2rem,4vw,4rem)/1.05 var(--serif)}.work{background:var(--cream)}.program-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.program-grid article{min-height:310px;padding:42px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:50px 1fr;align-content:start}.program-grid article>span{color:var(--rust);font-size:.75rem}.program-grid h3{margin-bottom:18px}.program-grid p,.program-grid a{grid-column:2;color:var(--muted)}.program-grid a{color:var(--ink);font-size:.8rem;font-weight:600;margin-top:25px}.heritage{display:grid;grid-template-columns:1.1fr .9fr;background:var(--paper)}.heritage-photo img{height:650px;object-fit:cover}.heritage-copy{padding:100px clamp(35px,8vw,120px);display:flex;flex-direction:column;justify-content:center}.heritage-copy p:not(.eyebrow){margin:25px 0 34px;color:var(--muted);font-size:1.05rem}.heritage-copy .button{align-self:flex-start}.history{background:var(--rust);color:#fff}.history .eyebrow{color:#ffe5bb}.history-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:45px;align-items:start}.milestone{border-top:1px solid #ffffff5c;padding-top:22px}.milestone strong{font:500 4.5rem var(--serif)}.milestone p{font-size:.85rem;color:#f5dcd4}.source-note{margin-top:50px;opacity:.68;font-size:.72rem}
@media(max-width:850px){.hero{grid-template-columns:1fr}.hero-copy{width:min(100% - 28px,1180px);margin:auto;padding:145px 0 55px}.hero-photo{min-height:480px}.photo-note{left:20px}.split{grid-template-columns:1fr;gap:30px}.program-grid{grid-template-columns:1fr}.heritage{grid-template-columns:1fr}.heritage-photo img{height:440px}.history-grid{grid-template-columns:1fr 1fr}.history-grid h2{grid-column:1/-1}}@media(max-width:520px){.hero{min-height:0}.hero h1{font-size:2.72rem}.hero-photo{min-height:380px}.actions{align-items:flex-start;flex-direction:column;gap:14px}.image-break{height:450px;margin:0}.image-break blockquote{left:24px;right:24px;bottom:30px}.program-grid article{padding:28px 22px}.heritage-copy{padding:70px 25px}.history-grid{grid-template-columns:1fr}}
</style>
