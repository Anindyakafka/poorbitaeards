---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Poorbita" description="Support Poorbita as a volunteer, intern, mentor, partner or donor.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Get involved</p><h1>Bring what you know.<br>Help possibility grow.</h1><p>Volunteer, intern, mentor, partner with us or support a program. We would be glad to hear from you.</p></div></section>
  <section class="section involvement"><div class="container"><div class="section-head"><div><p class="eyebrow">Support us</p><h2>Choose how you would<br>like to contribute.</h2></div><p>Time, professional knowledge and financial support can each strengthen locally led programs for Indigenous people, children and women.</p></div><div class="involvement-grid"><article><span>01</span><h3>Volunteer</h3><p>Contribute your time to education, community events, health initiatives, documentation or field activities.</p><a href="#contact-form">Volunteer with us →</a></article><article><span>02</span><h3>Internship</h3><p>Learn through supervised field experience while supporting research, communications or program delivery.</p><a href="#contact-form">Ask about internships →</a></article><article><span>03</span><h3>Mentor</h3><p>Share practical or professional expertise with children, adolescents, women, artisans or program teams.</p><a href="#contact-form">Become a mentor →</a></article><article><span>04</span><h3>Support a program</h3><p>Help sustain education, nutrition, health, livelihoods, culture and conservation initiatives.</p><a href="#support">Ways to support →</a></article></div></div></section>
  <section class="section contact" id="contact-form"><div class="container contact-grid"><div><p class="eyebrow">Reach us directly</p><h2>Start a conversation.</h2><dl><dt>Email</dt><dd><a href="mailto:eards15@gmail.com">eards15@gmail.com</a></dd><dt>Phone</dt><dd><a href="tel:+919903554891">+91 99035 54891</a><br><a href="tel:+917980231208">+91 79802 31208</a></dd><dt>Registered office</dt><dd>Ward No. 6, Egra<br>Purba Medinipur, West Bengal 721429</dd></dl><p class="note">Egra Agriculture and Rural Development Society<br>Society registration: SO134449 of 2005–2006</p></div><form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="contact"><p class="hidden"><label>Don’t fill this out: <input name="bot-field"></label></p><label>Name<input name="name" type="text" required autocomplete="name"></label><label>Email<input name="email" type="email" required autocomplete="email"></label><label>I’m interested in<select name="interest"><option>Volunteering</option><option>Internship</option><option>Mentoring</option><option>Partnership</option><option>Supporting a program</option><option>Learning more</option></select></label><label>Message<textarea name="message" rows="5" required></textarea></label><button class="button" type="submit">Send message <span>↗</span></button></form></div></section>
  <section class="support" id="support"><div class="container"><p class="eyebrow">Support Poorbita</p><h2>Give with confidence.</h2><p>Online donations are not enabled yet. Contact EARDS directly for current contribution details, 80G documentation and official receipts.</p><a class="button button--light" href="mailto:eards15@gmail.com?subject=I%20would%20like%20to%20support%20Poorbita">Ask how to support <span>↗</span></a></div></section>
</BaseLayout>
<style>
.involvement{background:var(--cream)}.involvement-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.involvement-grid article{padding:30px;min-height:270px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column}.involvement-grid span{color:var(--rust);font-size:.72rem}.involvement-grid h3{margin:24px 0 14px}.involvement-grid p{color:var(--muted);font-size:.88rem}.involvement-grid a{margin-top:auto;padding-top:25px;font-size:.78rem;font-weight:600}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.contact dl{margin:50px 0}.contact dt{font-size:.7rem;text-transform:uppercase;letter-spacing:.13em;color:var(--rust);margin-top:25px}.contact dd{margin:7px 0 0;font:400 1.2rem/1.6 var(--serif)}.note{font-size:.78rem;color:var(--muted);max-width:430px}.contact form{background:var(--cream);padding:50px}.contact label{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:24px}.contact input,.contact select,.contact textarea{display:block;width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;padding:10px 0;color:var(--ink);outline:none;text-transform:none;letter-spacing:0}.contact textarea{resize:vertical}.contact input:focus,.contact select:focus,.contact textarea:focus{border-color:var(--green)}.hidden{display:none}.support{background:var(--rust);color:#fff;padding:110px 0}.support .eyebrow{color:#ffe5bb}.support p:not(.eyebrow){max-width:620px;margin:25px 0 35px}@media(max-width:900px){.involvement-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.contact-grid,.involvement-grid{grid-template-columns:1fr}.contact-grid{gap:55px}.contact form{padding:30px 22px}.support{padding:75px 0}}
</style>
