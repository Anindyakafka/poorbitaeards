---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Poorbita" description="Contact EARDS and Poorbita about volunteering, partnerships, programmes and support.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1>Let’s make something<br>meaningful happen.</h1><p>Volunteer, partner with us, support a programme or ask a question. We would be glad to hear from you.</p></div></section>
  <section class="section contact"><div class="container contact-grid"><div><p class="eyebrow">Reach us directly</p><h2>Start a conversation.</h2><dl><dt>Email</dt><dd><a href="mailto:eards15@gmail.com">eards15@gmail.com</a></dd><dt>Phone</dt><dd><a href="tel:+919903554891">+91 99035 54891</a><br><a href="tel:+917980231208">+91 79802 31208</a></dd><dt>Registered office</dt><dd>Ward No. 6, Egra<br>Purba Medinipur, West Bengal 721429</dd></dl><p class="note">Egra Agriculture and Rural Development Society<br>Society registration: SO134449 of 2005–2006</p></div><form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="contact"><p class="hidden"><label>Don’t fill this out: <input name="bot-field"></label></p><label>Name<input name="name" type="text" required autocomplete="name"></label><label>Email<input name="email" type="email" required autocomplete="email"></label><label>I’m interested in<select name="interest"><option>Volunteering</option><option>Partnership</option><option>Supporting Poorbita</option><option>Learning more</option></select></label><label>Message<textarea name="message" rows="5" required></textarea></label><button class="button" type="submit">Send message <span>↗</span></button></form></div></section>
  <section class="support" id="support"><div class="container"><p class="eyebrow">Support Poorbita</p><h2>Give with confidence.</h2><p>Online donations are not enabled yet. Contact EARDS directly for current contribution details, 80G documentation and official receipts.</p><a class="button button--light" href="mailto:eards15@gmail.com?subject=I%20would%20like%20to%20support%20Poorbita">Ask how to support <span>↗</span></a></div></section>
</BaseLayout>
<style>
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.contact dl{margin:50px 0}.contact dt{font-size:.7rem;text-transform:uppercase;letter-spacing:.13em;color:var(--rust);margin-top:25px}.contact dd{margin:7px 0 0;font:400 1.2rem/1.6 var(--serif)}.note{font-size:.78rem;color:var(--muted);max-width:430px}.contact form{background:var(--cream);padding:50px}.contact label{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:24px}.contact input,.contact select,.contact textarea{display:block;width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;padding:10px 0;color:var(--ink);outline:none;text-transform:none;letter-spacing:0}.contact textarea{resize:vertical}.contact input:focus,.contact select:focus,.contact textarea:focus{border-color:var(--green)}.hidden{display:none}.support{background:var(--rust);color:#fff;padding:110px 0}.support .eyebrow{color:#ffe5bb}.support p:not(.eyebrow){max-width:620px;margin:25px 0 35px}@media(max-width:760px){.contact-grid{grid-template-columns:1fr;gap:55px}.contact form{padding:30px 22px}.support{padding:75px 0}}
</style>
