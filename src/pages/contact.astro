---
import BaseLayout from '../layouts/BaseLayout.astro';

const accounts = [
  { bank: 'State Bank of India', branch: 'Bolpur', account: '40944068854', ifsc: 'SBIN0002027' },
  { bank: 'Punjab National Bank', branch: 'Bolpur Bhubandanga', account: '0190050010613', ifsc: 'PUNB0082620' },
];
---
<BaseLayout title="Contact & Support — Poorbita" description="Volunteer, partner with or financially support Poorbita and Egra Agriculture and Rural Development Society.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Get involved</p><h1>Bring what you know.<br>Help possibility grow.</h1><p>Volunteer, intern, mentor, partner with us or support a program. We would be glad to hear from you.</p></div></section>

  <section class="section involvement"><div class="container"><div class="section-head"><div><p class="eyebrow">Support us</p><h2>Choose how you would<br>like to contribute.</h2></div><p>Time, professional knowledge and financial support can each strengthen locally led programs for Indigenous people, children and women.</p></div><div class="involvement-grid"><article><span>01</span><h3>Volunteer</h3><p>Contribute time in education, health, culture, agriculture, events or community outreach.</p><a href="#contact-form">Volunteer with us →</a></article><article><span>02</span><h3>Intern</h3><p>Build field experience while supporting research, communications or program delivery.</p><a href="#contact-form">Ask about internships →</a></article><article><span>03</span><h3>Mentor</h3><p>Share practical or professional expertise with children, adolescents, women, artisans or program teams.</p><a href="#contact-form">Become a mentor →</a></article><article><span>04</span><h3>Partner</h3><p>Educational institutions, companies, CSR teams, foundations and community groups are invited to work with us.</p><a href="#contact-form">Discuss a partnership →</a></article></div></div></section>

  <section class="section contact" id="contact-form"><div class="container contact-grid"><div><p class="eyebrow">Reach us directly</p><h2>Start a conversation.</h2><dl><dt>Email</dt><dd><a href="mailto:eards15@gmail.com">eards15@gmail.com</a></dd><dt>Phone</dt><dd><a href="tel:+919903554891">+91 99035 54891</a><br><a href="tel:+917980231208">+91 79802 31208</a></dd><dt>Poorbita campus</dt><dd>Village Sarpukurdanga, P.O. Khanjanpur<br>Birbhum, West Bengal 731236</dd><dt>Registered office</dt><dd>Ward No. 6, Egra<br>Purba Medinipur, West Bengal 721429</dd></dl><p class="note">Egra Agriculture and Rural Development Society<br>Society registration: SO134449 of 2005–2006</p></div><form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="contact"><p class="hidden"><label>Don’t fill this out: <input name="bot-field"></label></p><label>Name<input name="name" type="text" required autocomplete="name"></label><label>Email<input name="email" type="email" required autocomplete="email"></label><label>I’m interested in<select name="interest"><option>Volunteering</option><option>Internship</option><option>Mentoring</option><option>Partnership</option><option>Supporting a program</option><option>Learning more</option></select></label><label>Message<textarea name="message" rows="5" required></textarea></label><button class="button" type="submit">Send message <span>↗</span></button></form></div></section>

  <section class="section sponsorship" id="support"><div class="container"><div class="section-head"><div><p class="eyebrow">Support Kishalay</p><h2>Help a child learn,<br>grow and thrive.</h2></div><p>Support contributes to educational materials, learning assistance, nutrition, sports, cultural activities and centre operations.</p></div><div class="cost-grid"><article><span>Monthly program operations</span><strong>₹1,00,000</strong></article><article><span>Annual program requirement</span><strong>₹12,00,000</strong></article><article><span>Average annual support per child</span><strong>₹6,000</strong><small>approximately ₹500 per month</small></article></div></div></section>

  <section class="section payment"><div class="container payment-grid"><div><p class="eyebrow">Contribution details</p><h2>Support Poorbita directly.</h2><p>Contributions are accepted in the name of <strong>Egra Agriculture and Rural Development Society</strong>. UPI payments are also available through the organisation’s Punjab National Bank account.</p><p class="tax-note"><strong>80G registration:</strong> AAAAE7910L24KL01<br>Contact EARDS after contributing so the team can verify the payment and issue the appropriate receipt.</p><a class="button button--light" href="mailto:eards15@gmail.com?subject=Poorbita%20contribution%20receipt">Request a receipt <span>↗</span></a></div><div class="accounts">{accounts.map(account => <article><h3>{account.bank}</h3><dl><div><dt>Branch</dt><dd>{account.branch}</dd></div><div><dt>Account number</dt><dd>{account.account}</dd></div><div><dt>IFSC</dt><dd>{account.ifsc}</dd></div></dl></article>)}</div></div></section>
</BaseLayout>

<style>
.involvement{background:var(--cream)}.involvement-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.involvement-grid article{padding:30px;min-height:270px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column}.involvement-grid span{color:var(--rust);font-size:.72rem}.involvement-grid h3{margin:24px 0 14px}.involvement-grid p{color:var(--muted);font-size:.88rem}.involvement-grid a{margin-top:auto;padding-top:25px;font-size:.78rem;font-weight:600}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.contact dl{margin:50px 0}.contact dt{font-size:.7rem;text-transform:uppercase;letter-spacing:.13em;color:var(--rust);margin-top:25px}.contact dd{margin:7px 0 0;font:400 1.2rem/1.6 var(--serif)}.note{font-size:.78rem;color:var(--muted);max-width:430px}.contact form{background:var(--cream);padding:50px}.contact label{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:24px}.contact input,.contact select,.contact textarea{display:block;width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;padding:10px 0;color:var(--ink);outline:none;text-transform:none;letter-spacing:0}.contact textarea{resize:vertical}.contact input:focus,.contact select:focus,.contact textarea:focus{border-color:var(--green)}.hidden{display:none}.sponsorship{background:var(--rust);color:#fff}.sponsorship .eyebrow{color:#ffe5bb}.sponsorship .section-head>p{color:#f8ded6}.cost-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#ffffff40}.cost-grid article{padding:34px;background:var(--rust);display:flex;flex-direction:column;gap:15px}.cost-grid span{font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}.cost-grid strong{font:500 clamp(2.3rem,4vw,4rem) var(--serif)}.cost-grid small{color:#f8ded6}.payment{background:var(--green-dark);color:#fff}.payment-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px}.payment-grid>div:first-child>p:not(.eyebrow){margin:24px 0;color:#c8d6d1}.payment .eyebrow{color:var(--gold)}.tax-note{padding-top:22px;border-top:1px solid #ffffff30}.accounts{display:grid;gap:18px}.accounts article{padding:30px;background:#ffffff0d;border:1px solid #ffffff2e}.accounts h3{margin-bottom:24px}.accounts dl{margin:0}.accounts dl div{display:grid;grid-template-columns:145px 1fr;gap:20px;padding:10px 0;border-top:1px solid #ffffff24}.accounts dt{color:#abc1ba;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.accounts dd{margin:0;font-weight:600;overflow-wrap:anywhere}@media(max-width:900px){.involvement-grid{grid-template-columns:repeat(2,1fr)}.payment-grid{grid-template-columns:1fr;gap:55px}}@media(max-width:760px){.contact-grid,.involvement-grid,.cost-grid{grid-template-columns:1fr}.contact-grid{gap:55px}.contact form{padding:30px 22px}.accounts dl div{grid-template-columns:1fr;gap:4px}}
</style>
