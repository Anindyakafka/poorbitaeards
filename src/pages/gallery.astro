---
import BaseLayout from '../layouts/BaseLayout.astro';
const images=[['/images/g1.jpg','A Poorbita livelihood program'],['/images/g2.jpg','Rural craft and development activity'],['/images/g4.jpg','Traditional folk performance'],['/images/g3.jpg','Community gathering'],['/images/b2.jpg','Skills training session'],['/images/b3.jpg','Artisan training'],['/images/img_02.jpg','Community members'],['/images/mission.jpg','Poorbita field work']];
---
<BaseLayout title="Gallery — Poorbita"><section class="page-hero"><div class="container"><p class="eyebrow">From the field</p><h1>People, places<br>& shared work.</h1><p>A selection from Poorbita’s original archive—moments of learning, craft, culture and community.</p></div></section><section class="section"><div class="container gallery">{images.map((img,i)=><figure class:list={{wide:i===0||i===5}}><button data-src={img[0]} data-alt={img[1]} aria-label={`View ${img[1]}`}><img src={img[0]} alt={img[1]} loading={i<3?'eager':'lazy'}><span>View ↗</span></button><figcaption>{String(i+1).padStart(2,'0')} — {img[1]}</figcaption></figure>)}</div></section><dialog><button class="close" aria-label="Close image">×</button><img src="" alt=""></dialog><script>const dialog=document.querySelector('dialog');const full=dialog?.querySelector('img');document.querySelectorAll<HTMLButtonElement>('[data-src]').forEach(button=>button.addEventListener('click',()=>{if(full){full.src=button.dataset.src||'';full.alt=button.dataset.alt||''}dialog?.showModal()}));document.querySelector('.close')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});</script></BaseLayout>
<style>.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:60px 28px}.gallery figure{margin:0}.gallery figure:nth-child(even){margin-top:100px}.gallery figure.wide{grid-column:span 2}.gallery button{width:100%;padding:0;border:0;background:none;cursor:pointer;position:relative;overflow:hidden}.gallery img{height:460px;object-fit:cover;transition:transform .5s}.gallery .wide img{height:640px}.gallery button span{position:absolute;right:15px;bottom:15px;background:var(--paper);padding:10px 16px;font-size:.75rem;opacity:0;transform:translateY(5px);transition:.2s}.gallery button:hover img{transform:scale(1.025)}.gallery button:hover span{opacity:1;transform:none}.gallery figcaption{font-size:.75rem;color:var(--muted);margin-top:12px}dialog{width:min(1100px,92vw);height:min(820px,90vh);padding:0;border:0;background:#111}dialog::backdrop{background:#07140fd9}dialog img{height:100%;object-fit:contain}.close{position:absolute;z-index:2;right:12px;top:12px;width:42px;height:42px;border:0;border-radius:50%;background:white;font-size:1.6rem;cursor:pointer}@media(max-width:650px){.gallery{grid-template-columns:1fr}.gallery figure:nth-child(even){margin-top:0}.gallery figure.wide{grid-column:auto}.gallery img,.gallery .wide img{height:420px}}</style>
